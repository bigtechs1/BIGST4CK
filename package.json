{
  "name": "BIGST4CK",
  "version": "3.0.5",
  "description": "Bin WhatsApp Bot - BIGST4CK",
  "main": "index.js",
  "scripts": {
    "start": "node server.js",
    "start:optimized": "node --max-old-space-size=512 --optimize-for-size --gc-interval=100 --max-semi-space-size=128 --expose-gc index.js",
    "cleanup": "node cleanup.js",
    "reset-session": "node reset-session.js",
    "start:clean": "npm run cleanup && npm run start:optimized",
    "start:fresh": "npm run reset-session && npm run start:optimized",
    "start:stable": "node --max-old-space-size=1024 --optimize-for-size --gc-interval=50 --max-semi-space-size=256 --expose-gc server.js",
    "install:panel": "npm install --legacy-peer-deps",
    "install:force": "npm install --force"
  },
  "keywords": ["whatsapp-bot"],
  "author": "bigmanjtech",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc11",
    "axios": "^1.8.4",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "moment-timezone": "^0.5.43",
    "node-cache": "^5.1.2",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.32.6",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}